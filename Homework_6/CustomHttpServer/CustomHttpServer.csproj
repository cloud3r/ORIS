<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Update="settings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="static\search-engine.html">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    	<Content Include="static\**\*">
        	<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    	</Content>
	    <None Update="secret.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    </ItemGroup>

</Project>